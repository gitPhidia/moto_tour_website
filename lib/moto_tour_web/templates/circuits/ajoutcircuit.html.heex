<div class="mt-1">
  <h5>Ajouter un Circuit 
  <!--<a href={Routes.photo_path(@conn, :new)}><button><i class="fa fa-picture-o"></i> ajouter une photo</button></a> 
  <a href={Routes.itineraire_path(@conn, :ajout)}><button><i class="fa fa-road"></i> ajouter un itineraire</button></a>--></h5>
  <%= form_for @changeset, Routes.circuits_path(@conn, :create), fn f -> %>
    <%= if @changeset.action do %>
      <div class="alert alert-danger">
        <p>Oops, une erreur s'est produite!</p>
      </div>
    <% end %>


  <div class="row">
    <div class="col-6">
      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Nom du circuit</label>
        <%= text_input f, :nom %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La description sur la carte</label>
        <%= text_input f, :desc_card %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Tarifs</label>
        <%= text_input f, :tarifs %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La durée du circuit</label>
        <%= text_input f, :durée %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Nombre de participants</label>
        <%= text_input f, :participant %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Les moto disponibles pour ce circuit</label>
        <%= text_input f, :moto %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La difficulté du circuit</label>
        <%= number_input f, :difficulté %>
      </div>

       <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Véhicule d'assistance</label>
        <%= checkbox f, :assistance %>
      </div>
    </div>

    <div class="col-6 mt-3">
      <label style="width: 200px;">Vos remarques sur ce circuit</label>
      <div class="form-group" style="display: flex; align-items: center;">
        <%= textarea f, :remarque, style: "flex: 1;height: 125px;" %>
      </div>

      <label style="width: 300px;">Sites marquants</label>
      <div class="form-group mt-2" style="display: flex; align-items: center;">
        <%= textarea f, :details, style: "flex: 1;height: 125px;" %>
      </div>
    </div>  
  </div>

    <%= submit "Enregistrer", style: "flex: 1;margin-left:90%;margin-top: 10px;padding: 5px 10px; background-color: #0d6efd; color: white; border: none; border-radius: 5px;" %>
  <% end %>
</div>