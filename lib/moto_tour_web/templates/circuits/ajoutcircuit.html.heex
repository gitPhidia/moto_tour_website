<div class="mt-1">
  <h5>Ajouter un Circuit 
  <!--<a href={Routes.photo_path(@conn, :new)}><button><i class="fa fa-picture-o"></i> ajouter une photo</button></a> 
  <a href={Routes.itineraire_path(@conn, :ajout)}><button><i class="fa fa-road"></i> ajouter un itineraire</button></a>--></h5>
  <%= form_for @changeset, Routes.circuits_path(@conn, :create), [as: :circuit], fn f -> %>
    <%= if @changeset.action do %>
      <div class="alert alert-danger">
        <p>Oops, une erreur s'est produite!</p>
      </div>
    <% end %>


  <div class="row">
    <div class="col-6">
      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Nom du circuit</label>
        <%= text_input f, :nom, value: input_value(f, :nom) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La description sur la carte</label>
        <%= text_input f, :desc_card, value: input_value(f, :desc_card) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Tarifs</label>
        <%= text_input f, :tarifs, value: input_value(f, :tarifs) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La durée du circuit</label>
        <%= text_input f, :durée, value: input_value(f, :durée) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Nombre de participants</label>
        <%= text_input f, :participant, value: input_value(f, :participant) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">Les moto disponibles pour ce circuit</label>
        <%= text_input f, :moto, value: input_value(f, :moto) %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 150px;">La difficulté du circuit</label>
        <%= number_input f, :difficulté, min: 1, max: 5, step: 1, value: input_value(f, :difficulté) %>
      </div>

    </div>

    <div class="col-6 mt-3">
      <label style="width: 200px;">Vos remarques sur ce circuit</label>
      <div class="form-group" style="display: flex; align-items: center;">
        <%= textarea f, :remarque, style: "flex: 1;height: 125px;", value: input_value(f, :remarque) %>
      </div>

      <label style="width: 300px;">Sites marquants</label>
      <div class="form-group mt-2" style="display: flex; align-items: center;">
        <%= textarea f, :details, style: "flex: 1;height: 125px;display: none;", value: input_value(f, :details) %>
      </div>

    <div id="editor-container" style="height: 200px;"></div>

      <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
        var textarea = document.getElementById("details");

        var quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Écrivez ici...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['link']
                ]
              }
          });

          // Attendre que le DOM soit chargé avant d'insérer le contenu
          if (textarea.value.trim() !== "") {
              quill.clipboard.dangerouslyPasteHTML(textarea.value);
          }

          // Synchroniser Quill avec le textarea lors des modifications
          quill.on('text-change', function() {
              textarea.value = quill.root.innerHTML;
          });
        });

        document.addEventListener("DOMContentLoaded", function () {
          const form = document.querySelector("form");
          const inputs = form.querySelectorAll("input, textarea, select");

          // Charger les valeurs sauvegardées depuis le localStorage
          inputs.forEach((input) => {
            const savedValue = localStorage.getItem(input.name);
            if (savedValue) {
              input.value = savedValue;
            }

            // Sauvegarder la valeur à chaque modification
            input.addEventListener("input", () => {
              localStorage.setItem(input.name, input.value);
            });
          });

          // Effacer le stockage local à la soumission du formulaire
          form.addEventListener("submit", () => {
            inputs.forEach((input) => {
              localStorage.removeItem(input.name);
            });
          });
        });
      </script>  
    </div>
  </div>

    <%= submit "Enregistrer", style: "flex: 1;margin-left:90%;margin-top: 10px;padding: 5px 10px; background-color: #0d6efd; color: white; border: none; border-radius: 5px;" %>
  <% end %>
</div>