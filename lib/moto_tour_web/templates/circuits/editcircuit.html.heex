<div class="row">
  <div class="col-md-6">
    <h5>Modifier le circuit <%= @circuit.nom %></h5>
    <a data-bs-toggle="tooltip" data-bs-placement="top" title="les photos du circuit" href={Routes.photo_path(@conn, :detail, @circuit.id)}><button style="padding: 5px 10px; background-color: grey; color: white; border: none; border-radius: 5px;"><i class="fa fa-picture-o"></i> Photos</button></a>
    <a data-bs-toggle="tooltip" data-bs-placement="top" title="les itineraires du circuit" href={Routes.itineraire_path(@conn, :liste, @circuit.id)}><button style="padding: 5px 10px; background-color: grey; color: white; border: none; border-radius: 5px;"><i class="fa fa-road"></i> Itineraires</button></a>
    <a data-bs-toggle="tooltip" data-bs-placement="top" title="les prestations du circuit" href={Routes.live_path(@conn, MotoTourWeb.TarifLive, @circuit.id)}><button style="padding: 5px 10px; background-color: grey; color: white; border: none; border-radius: 5px;"><i class="fa fa-euro-sign"></i> Prestation</button></a>
  </div>
  <div class="col-md-6">

    <span class="mt-3 d-flex">
      <nav aria-label="Page navigation example">
        <ul class="pagination">
          <li class="page-item">
            <a class="page-link" href={if @adjacent["previous_id"], do: Routes.circuits_path(@conn, :edit, @adjacent["previous_id"]), else: "#"} aria-label="Previous">
              <span aria-hidden="true">&laquo;</span>
              <span class="sr-only">Previous</span>
            </a>
          </li>
          <%= for {c, index} <- Enum.with_index(@id, 1) do %>
            <li class="page-item"><a class={"page-link #{if c.id == @circuit.id, do: "active", else: ""}"}  data-bs-toggle="tooltip" data-bs-placement="top" title={c.nom} href={Routes.circuits_path(@conn, :edit, c.id)}><%= index %></a></li>
          <%= end %>
          <li class="page-item">
            <a class="page-link" href={if @adjacent["next_id"], do: Routes.circuits_path(@conn, :edit, @adjacent["next_id"]), else: "#"} aria-label="Next">
              <span aria-hidden="true">&raquo;</span>
              <span class="sr-only">Next</span>
            </a>
          </li>
        </ul>
      </nav>
    </span>

  </div>
</div>

<div class="mt-1">
  <%= form_for @changeset, Routes.circuits_path(@conn, :update, @circuit), [method: :put], fn f -> %>

    <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, une erreur s'est produite!</p>
    </div>
  <% end %>
    
  <div class="row">
    <div class="col-6">
      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">Nom du circuit</label>
        <%= text_input f, :nom %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">La description sur la carte</label>
        <%= text_input f, :desc_card %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">Tarif à partir de</label>
        <%= text_input f, :tarifs %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">La durée du circuit</label>
        <%= text_input f, :durée %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">Nombre de participants</label>
        <%= text_input f, :participant %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">Les moto disponibles pour ce circuit</label>
        <%= text_input f, :moto %>
      </div>

      <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">La difficulté du circuit</label>
        <%= number_input f, :difficulté, min: 1, max: 5, step: 1, class: "form-control", onkeydown: "return false;" %>
      </div>

      <!-- <div class="form-group" style="display: flex; align-items: center;">
        <label style="width: 130px;">Véhicule d'assistance</label>
        <%= checkbox f, :assistance %>
      </div> -->

    </div>

    <div class="col-6 mt-3">
      <label style="width: 200px;">Vos remarques sur ce circuit</label>
      <div class="form-group" style="display: flex; align-items: center;">
        <%= textarea f, :remarque, style: "flex: 1;height: 125px;" %>
      </div>

      <label style="width: 150px;">Sites marquants</label>
      <div class="form-group mt-2" style="display: flex; align-items: center;">
        <%= textarea f, :details, style: "flex: 1;height: 125px;display: none;", id: "details" %>
      </div>

      <div id="editor-container" style="height: 200px;"></div>

      <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
        var textarea = document.getElementById("details");

        var quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Écrivez ici...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['link']
                ]
              }
          });

          // Attendre que le DOM soit chargé avant d'insérer le contenu
          if (textarea.value.trim() !== "") {
              quill.clipboard.dangerouslyPasteHTML(textarea.value);
          }

          // Synchroniser Quill avec le textarea lors des modifications
          quill.on('text-change', function() {
              textarea.value = quill.root.innerHTML;
          });
        });
      </script>
    </div>  
  </div>


    <div>
      <%= submit "Enregistrer", style: "flex: 1;margin-left:90%;margin-top: 10px;padding: 5px 10px; background-color: #0d6efd; color: white; border: none; border-radius: 5px;" %>
    </div>
  <% end %>
</div>