<div class="container"> 
  <h5>Ajouter un itineraire <%= @circuits.nom %></h5>
  <a href={Routes.itineraire_path(@conn, :liste, @circuits.id)}>Retour</a>
  <%= form_for @changeset, Routes.itineraire_path(@conn, :create), [id: "itineraire-form", phx_submit: "save_itineraire"], fn f -> %>
    <%= if @changeset.action do %>
      <div class="alert alert-danger">
        <p>Oops, une erreur s'est produite!</p>
      </div>
    <% end %>

    <div class="form-group" style="display: flex; align-items: center;">
      <label style="width: 130px;">Numéro d’étape</label>
      <%= number_input f, :numero, style: "width:90%;margin-left:5%" %>
      <%= error_tag f, :numero %>
    </div>

    <div class="form-group" style="display: flex; align-items: center;">
      <label style="width: 130px;">Jour</label>
      <%= number_input f, :jour, style: "width:90%;margin-left:5%" %>
      <%= error_tag f, :jour %>
    </div>

    <div class="form-group" style="display: flex; align-items: center;">
      <label style="width: 130px;">Lieu de départ</label>
      <%= text_input f, :depart, style: "width:90%;margin-left:5%" %>
      <%= error_tag f, :depart %>
    </div>

    <div class="form-group" style="display: flex; align-items: center;">
      <label style="width: 130px;">Lieu d'arriver</label>
      <%= text_input f, :arriver, style: "width:90%;margin-left:5%" %>
      <%= error_tag f, :arriver %>
    </div>

    <div class="form-group" style="display: flex; align-items: center;">
      <%= label f, :distance, style: "width: 130px;" %>
      <%= text_input f, :distance, style: "width:90%;margin-left:5%" %>
      <%= error_tag f, :distance %>
    </div>

    <div class="form-group" style="display: flex; align-items: center;">
      <%= label f, :description, style: "width: 130px;" %>
      <%= textarea f, :remarque, style: "flex: 1;height: 130px;width:90%;margin-left:3%" %>
      <%= error_tag f, :remarque %>
    </div>


  <!-- Champ caché pour id -->
  <%= hidden_input f, :idcircuit, value: @id %>

    <div style="margin-top:20px;margin-left:90%">
      <%= submit "confirmer" %>
    </div>
  <% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("itineraire-form");
  const popup = document.getElementById("custom-popup");
  const popupMessage = document.getElementById("popup-message");
  const closeButton = document.getElementById("close-popup");

  if (form) {
    form.addEventListener("submit", function (event) {
      event.preventDefault(); // Empêche le rechargement de la page

      const formData = new FormData(form);

      fetch(form.action, {
        method: "POST",
        body: formData,
        headers: {
          "X-Requested-With": "XMLHttpRequest"
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          popupMessage.textContent = "Itinéraire ajouté avec succès !";
          popup.classList.remove("hidden"); // Afficher le pop-up
        } else {
          popupMessage.textContent = "Erreur lors de l'ajout de l'itinéraire.";
          popup.classList.remove("hidden");
        }
      })
      .catch(error => {
        console.error("Erreur:", error);
        popupMessage.textContent = "Une erreur est survenue.";
        popup.classList.remove("hidden");
      });
    });
  }

  if (closeButton) {
    closeButton.addEventListener("click", function () {
      popup.classList.add("hidden"); // Masquer le pop-up
    });
  }
});
</script>
</div>