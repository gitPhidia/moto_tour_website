<!DOCTYPE html>
<html lang="en"><head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()}>

    <title>Tableau de bord</title>

    <%= csrf_meta_tag() %>
    <%= live_title_tag assigns[:page_title] || "MyBs", suffix: " · Phoenix Framework" %>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>

  <body>
    <header id="header" class="header fixed-top d-flex align-items-center" style="height:30px;">
      <a class="navbar-brand col-sm-1 col-md-1 mr-0 d-flex justify-content-center" href={Routes.page_path(@conn, :index)}> Site Moto tour</a>
      <a class="navbar-brand col-sm-1 col-md-1 mr-0 d-flex justify-content-center" href={Routes.page_path(@conn, :bcircuit)}> Circuits</a>
      <a class="navbar-brand col-sm-1 col-md-1 mr-0 d-flex justify-content-center" href={Routes.questions_path(@conn, :index)}> Questions</a>
      <a class="navbar-brand col-sm-1 col-md-1 mr-0 d-flex justify-content-center" href={Routes.videos_path(@conn, :ajout)}> Video</a>
      <%= link "Déconnexion", to: Routes.user_session_path(@conn, :delete), method: :delete, class: "navbar-brand col-sm-7 col-md-7 d-flex justify-content-end" %>
    </header>

    <div class="section mt-2">
      <%= @inner_content %>
    </div>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>
</html>