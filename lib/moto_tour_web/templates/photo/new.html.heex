<div class="container">
  <h5>Nouvelle photo dans <%= @c_nom.circuit_nom %></h5>
  <a href={Routes.photo_path(@conn, :detail, @id)}>retour</a>

  <%= form_for @changeset, Routes.photo_path(@conn, :create), [multipart: true], fn f -> %>

    <%= if @changeset.action do %>
      <div class="alert alert-danger">
        <p>Oops, une erreur s'est produite!</p>
      </div>
    <% end %>

  <div class="form-group" style="display: flex; align-items: center;">
    <%= label f, :nom %>
    <%= text_input f, :nom %>
    <%= error_tag f, :nom %>
  </div>

  <!-- Champ caché pour id -->
  <%= hidden_input f, :idcircuit, value: @id %>

  <div class="form-group" style="display: flex; align-items: center;" style="margin-top:20px">
    <%= label f, :photo %>
    <%= file_input f, :photo %>
    <%= error_tag f, :photo %>
  </div>

    <div style="margin-top:20px">
      <%= submit "Upload", style: "flex: 1;margin-left:90%;margin-top: 10px;" %>
    </div>
  <% end %>
</div>
